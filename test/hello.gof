##

def captures_with_discovered_attack_and_check(From, Captured_To, King, AttackFrom, AttackTo) then
  attack_through(AttackFrom, AttackTo, From)
  capture(From, To, Captured)
  attack(To, King)
  attack(AttackFrom, AttackTo)

def promotes(From, To_Promotion) then
  promote(From, To, Promotion)

def captures_hanging(From, Captured_To)
  defend(null, Captured) and
  capture(From, To, Captured)

def pawn_push_attacks(From, To, AttackTo)
  pawn_push(From, To) then
  attack(To, AttackTo)

def captures_with_check(From, Captured_To, King)
  capture(From, To, Captured) then
  attack(To, King)

def pawn_push_blocks_check(From, To, AFrom, ATo) then
  attack(AFrom, ATo)
  pawn_push(From, To)
  attack_through(AFrom, ATo, To)

def evades(From, To)
  move(From, To)

def attacks2(From, To, AttackTo)
  move(From, To)
  attack(To, AttackTo)

def attacks_hanging(From, To, Hanging)
  attack(null, Hanging)
  move(From, To)
  attack(To, Hanging)

def discovered_check(From, To, AFrom, ATo)
  attack_through(AFrom, ATo, From) and
  move(From, To) then
  attack(AFrom, ATo)

def checks(From, To, King) then
  move(From, To) then
  attack(To, King)

def blocks_check(From, To, AFrom, ATo)
  attack(AFrom, ATo) and
  move(From, To) then
  attack_through(AFrom, ATo, To)

def captures(From, Captured_To)
  capture(From, To, Captured) then

def king_evades(From, To) then
  move(From, To) then

def has_fork(From, To, ForkA, ForkB)
  move(From, To) then
  attack(To, ForkA) and
  attack(To, ForkB)