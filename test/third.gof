def exchanges(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  capture(From2, To2, To)

def king_evades(From, To)
  safe_move(From, To)

def double_checks(From, To, CheckFrom, CheckTo)
  attack_through(CheckFrom, CheckTo, From)
  move(From, To)
  attack(To, CheckTo)
  attack(CheckFrom, CheckTo)

def lures_into_discovered_check(To, DiscoverFrom, DiscoverTo)
  attack_through(DiscoverFrom, To, DiscoverTo)

def sacrifices(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  capture(From2, To2, To)

def captures(From, Captured_To)
  capture(From, To, Captured)

def exchange(From, Captured_To, From2, Captured2_To2)
  capture(From, To, Captured)
  capture(From2, To2, Captured2)

def blocks(From, To, AttackFrom, AttackTo)
  move(From, To)
  attack_through(AttackFrom, AttackTo, To)

def checks(From, To, King)
  move(From, To)
  attack(To, King)

def evades_attack_non_confrontational(From, To, AttackFrom)
  move(From, To)
  no_attack(AttackFrom, To)

def attack_and_through(From, To, AttackTo, AttackThrough)
  move(From, To)
  attack(To, AttackTo)
  attack_through(To, AttackThrough, AttackTo)
  


def has_attack_hanging(From, Hanging)
  attack(From, Hanging)
  no_defense(Hanging)

def correspondence_threats(FromA, AttackA, FromB, AttackB)
  attack(AttackA, FromA)
  attack(AttackB, FromB)
  opposite(AttackA, FromA)
  opposite(AttackB, FromB)
  opposite(FromA, FromB)

def captures_with_check_king_no_block_no_capture(From, Captured_To, King)
  capture(From, To, Captured)
  attack(To, King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)
  opposite(To, King)

def blocks_check(From, To, AttackFrom, AttackTo)
  move(From, To)
  attack_through(AttackFrom, AttackTo, To)

def check_king_with_block_no_capture_no_evade(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_push_blocks_check(To, King)


def in_backrank_wall(King, A, B, C)
  backrank_wall(King, A, B, C)

def check_king_no_block_no_capture(From, To, King) then
  move(From, To)
  attack(To, King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)
  opposite(To, King)

def captures_with_checkmate(From, To_Captured, King)
  capture(From, To, Captured)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)



  
def checkmate(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)

