def capture_unpins_exchange(From, Captured_To, AttackFrom, AttackTo)
  attack_through(AttackFrom, AttackTo, From)
  capture(From, To, Captured)
  attack(AttackFrom, AttackTo)

def removes_defender_with_check(From, Captured_To, King, Defended)
  defend(Captured, Defended)
  capture(From, To, Captured)
  attack(To, King)

def defends(From, To)
  defend(From, To)

def attacks_and_attacks_through(From, Through, To)
  attack_through(From, To, Through)
  attack(To, Through)


def captures_with_discover_tension(From, Captured_To, TensionA, TensionB)
  attack_through(TensionA, TensionB, From)
  capture(From, To, Captured)
  attack(TensionB, TensionA)
  attack(TensionA, TensionB)

def evades(From, To, AttackFrom)
  move(From, To)
  no_attack(To, AttackFrom)
  

def has_fork_with_capture(From, Captured_To, ForkA, ForkB)
  capture(From, To, Captured)
  attack(To, ForkA)
  attack(To, ForkB)

def push_attack_with_discovered_check(From, To, AttackTo, DiscoverFrom, DiscoverTo)
  attack_through(DiscoverFrom, DiscoverTo, From)
  push(From, To)
  attack(To, AttackTo)
  attack(DiscoverFrom, DiscoverTo)


def skewers(From, To, SkewerThrough, SkewerTo)
  move(From, To)
  attack_through(To, SkewerTo, SkewerThrough)

def push_blocks(From, To, AttackFrom, AttackTo)
  push(From, To)
  attack_through(AttackFrom, AttackTo, To)


def check_with_discovered_attack(From, To, King, DiscoverFrom, DiscoverTo)
  move(From, To)
  attack(To, King)
  attack(DiscoverFrom, DiscoverTo)
  

def attacks_safe(From, To, AttackTo)
  move(From, To)
  attack(To, AttackTo)
  no_captures(To)


def recapture_into_discovered_attack(From, Captured_To, DiscoverFrom, DiscoverThrough) 
  capture(From, To, Captured)
  attack_through(DiscoverFrom, To, DiscoverThrough)

def blocks_check(From, To, AttackFrom, AttackTo)
  move(From, To)
  attack_through(AttackFrom, AttackTo, To)

def has_cover_safe(From, To, CoverTo)
  move(From, To)
  attack(To, CoverTo)
  no_captures(To)



def has_cover(From, To, CoverTo)
  move(From, To)
  attack(To, CoverTo)

def hanging_pin(From, To, PinThrough, PinTo)
  move(From, To)
  attack_through(To, PinTo, PinThrough)
  no_defense(To)



def pin(From, To, PinThrough, PinTo)
  move(From, To)
  attack_through(To, PinTo, PinThrough)

def has_defend(From, To)
  defend(From, To)

def pushes(From, To)
  push(From, To)

def has_eye_zone(From, To, King)
  attack(From, To)
  defend(King, To)

def attacks(From, To, AttackTo)
  move(From, To)
  attack(To, AttackTo)

def has_fork_hanging(From, To, ForkA, ForkHanging)
  move(From, To)
  no_defense(ForkHanging)
  attack(To, ForkA)
  attack(To, ForkHanging)


def king_evades(From, To)
  move(From, To)

def captures_zone(From, Captured_To, SupportFrom, King)
  capture(From, To, Captured)
  defend(SupportFrom, To)
  attack(King, To)

def captures_hanging(From, Captured_To)
  no_defense(Captured)
  capture(From, To, Captured)

def exchanges(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  capture(From2, To2, To)



def exchanges_last(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  no_defense(To)
  capture(From2, To2, To)

def has_attack_and_through(From, FromThrough, To)
  attack_through(From, To, FromThrough)
  attack(FromThrough, To)

def attacks_and_through(From, To, Through, ThroughTo)
  move(From, To)
  attack_through(To, ThroughTo, Through)

def sacrifice_exchange(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  capture(From2, To2, To)

def blocks(From, To, AttackFrom, AttackTo)
  move(From, To)
  attack_through(AttackFrom, AttackTo, To)

def checks(From, To, King)
  move(From, To)
  attack(To, King)

def zone_threat(From, From2, To, King)
  defend(King, To)
  attack(From, To)
  attack(From2, To)

def captures(From, Captured_To)
  capture(From, To, Captured)


  
def checks_with_only_push_block(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)



  
def check_no_evade_no_capture(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_push_blocks_check(To, King)


    
def checkmate_with_capture(From, Captured_To, King)
  capture(From, To, Captured)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)

  
def checkmate(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)

