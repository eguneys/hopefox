def captures_hanging(From, Captured_To)
  no_defense(Captured)
  capture(From, To, Captured)


def triple_fork_with_checks_and_hanging_for_only_king_evades(From, To, King, ForkB, ForkC)
  move(From, To)
  attack(To, King)
  attack(To, ForkB)
  attack(To, ForkC)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)
  no_defense(ForkB)



def triple_fork_with_checks_for_only_king_evades(From, To, King, ForkB, ForkC)
  move(From, To)
  attack(To, King)
  attack(To, ForkB)
  attack(To, ForkC)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)



def attacks(From, To, AttackTo) then
  move(From, To)
  attack(To, AttackTo)

def defends(From, To, DefendTo) then
  move(From, To)
  defend(To, DefendTo)

def covers_push(From, To, To2) then
  move(From, To)
  attack(To, To2)

def pushes_for_blocks(From, To, To2) then
  push(From, To)
  about_to_push(To, To2)

def blocks_promotion(From, Promotion_To) then
  move(From, To)
  same(Promotion, To)

def defends_promotion(From, To, Pawn) then
  move(From, To)
  attack(To, Pawn)

def defends_promotion_from_behind(From, To, Pawn, Promotion) then
  move(From, To)
  attack(To, Pawn)
  attack_through(To, Promotion, Pawn)

def pushes_to_promote(From, To, Promotion) then
  push(From, To)
  about_to_promote(To, Promotion)

def pushes(From, To)
  push(From, To)


def promotes(From, To_Promotion) then
  promote(From, To, Promotion)

def push_attacks(From, To, AttackTo)
  push(From, To)
  attack(To, AttackTo)

def checks_with_a_skewer(From, To, King, SkewerTo) then
  move(From, To)
  attack(To, King)
  attack_through(To, SkewerTo, King)

def checks_defended_by_also_evades_attack(From, To, King, Defender, Attacker) then
  attack(Attacker, From)
  move(From, To)
  attack(To, King)


def checks_defended_by(From, To, King, Defender)
  move(From, To)
  attack(To, King)
  defend(Defender, To)

def has_no_captures(To)
  no_captures(To)

def has_check_with_discovered_attack_on_hanging(From, To, King, DiscoverFrom, DiscoverTo)
  attack_through(DiscoverFrom, DiscoverTo, To)
  move(From, To)
  attack(To, King)
  attack(DiscoverFrom, DiscoverTo)

def checks(From, To, King) then
  move(From, To)
  attack(To, King)

def captures(From, Captured_To)
  capture(From, To, Captured)


def has_fork(From, To, ForkA, ForkB)
  move(From, To)
  attack(To, ForkA)
  attack(To, ForkB)

def checkmate(From, To, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)

def checks_for_only_king_evades(From, To, King)
  move(From, To)
  attack(To, King)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)

def king_evades(From, To)
  safe_move(From, To)


def king_evades_and_attacks_hanging(From, To, Hanging)
  safe_move(From, To)
  attack(To, Hanging)
  no_defense(Hanging)


def has_fork_with_checks_for_only_king_evades(From, To, King, ForkB)
  move(From, To)
  attack(To, King)
  attack(To, ForkB)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)


def has_fork_with_checks_and_hanging_for_only_king_evades(From, To, King, ForkB)
  move(From, To)
  attack(To, King)
  attack(To, ForkB)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)
  no_defense(ForkB)




  
def has_fork_with_checks_for_only_king_evades_and_discovered_attack(From, To, King, ForkB, DiscoverFrom, DiscoverTo)
  attack_through(DiscoverFrom, DiscoverTo, To)
  move(From, To)
  attack(To, King)
  attack(To, ForkB)
  no_captures(To)
  no_blocks_check(To, King)
  no_push_blocks_check(To, King)
  attack(DiscoverFrom, DiscoverTo)