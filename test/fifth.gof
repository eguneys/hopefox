def push_discovered_check_with_attack(From, To, AttackTo, DiscoverFrom, DiscoverTo)
  attack_through(DiscoverFrom, DiscoverTo, From)
  push(From, To)
  attack(To, AttackTo)
  attack(DiscoverFrom, DiscoverTo)

def skewer(From, To, SkewerThrough, SkewerTo)
  move(From, To)
  attack_through(To, SkewerTo, SkewerThrough)

def offers_exchange(From, To, ExchangeTo, SupportFrom)
  move(From, To)
  attack(To, ExchangeTo)
  attack(ExchangeTo, To)
  defend(SupportFrom, To)

def captures_hanging_with_check(From, Captured_To, King)
  no_defense(Captured)
  capture(From, To, Captured)
  attack(To, King)


def push_blocks_check(From, To, CheckFrom, King)
  push(From, To)
  attack_through(CheckFrom, King, To)

def check_with_only_push_block(From, To, PawnFrom, PawnTo, King)
  move(From, To)
  attack(To, King)
  no_king_evades(King)
  no_captures(To)
  no_blocks_check(To, King)



def sacrifices_with_check(From, To, King)
  move(From, To)
  attack(To, King)


def captures_into_discovered_attack(From, Captured_To, AttackFrom, AttackThrough)
  capture(From, To, Captured)
  attack_through(AttackFrom, To, AttackThrough)

def captures_with_attack(From, Captured_To, AttackTo)
  capture(From, To, Captured)
  attack(To, AttackTo)

def pins(From, To, PinThrough, PinTo)
  move(From, To)
  attack_through(To, PinTo, PinThrough)

def has_attack(From, To)
  attack(From, To)

def pin_but_hangs(From, To, PinThrough, PinTo)
  move(From, To)
  no_defense(To)
  attack_through(To, PinTo, PinThrough)

def pushes(From, To)
  push(From, To)

def hanging(Hanging)
  no_defense(Hanging)

def eyes_king_zone(AttackFrom, AttackTo, King)
  attack(AttackFrom, AttackTo)
  attack(King, AttackTo)
  opposite(AttackFrom, King)

def attacks(From, To, AttackTo)
  move(From, To)
  attack(To, AttackTo)

def covers(From, To, CoverTo)
  move(From, To)
  attack(To, CoverTo)




def attacks_hanging(From, To, Hanging)
  move(From, To)
  no_defense(Hanging)
  attack(To, Hanging)

def has_fork(From, To, ForkA, ForkB)
  move(From, To)
  attack(To, ForkA)
  attack(To, ForkB)
  opposite(To, ForkA)
  opposite(To, ForkB)

def king_evades(From, To)
  move(From, To)

def checks_zone_with_capture(From, Captured_To, SupportFrom, King)
  attack(King, Captured)
  attack(SupportFrom, Captured)
  capture(From, To, Captured)

def hangs_to(From, Captured_To, AttackFrom)
  move(From, Captured)
  capture(AttackFrom, To, Captured)

def exchanges_hanging(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  no_defense(To)
  capture(From2, To2, To)



def exchanges(From, Captured_To, From2, To2)
  capture(From, To, Captured)
  capture(From2, To2, To)

def defends(From, To)
  defend(From, To)

def attacks_through(From, To, Through)
  attack_through(From, To, Through)

def blocks_check_attacked_by(From, To, AttackedFrom, AttackFrom, AttackTo)
  move(From, To)
  attack(AttackedFrom, To)
  attack_through(AttackFrom, AttackTo, To)

def blocks_check_defended_by(From, To, DefendFrom, AttackFrom, AttackTo)
  move(From, To)
  defend(DefendFrom, To)
  attack_through(AttackFrom, AttackTo, To)
  
def blocks_check_no_defense(From, To, AttackFrom, AttackTo)
  move(From, To)
  no_defense(To)
  attack_through(AttackFrom, AttackTo, To)
  

def checks(From, To, King)
  move(From, To)
  attack(To, King)

def no_cover(From, To, NoCover)
